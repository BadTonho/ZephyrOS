{
  "schema": "zephyros-hardware-profile-v1",
  "version": 1,
  "scope": "qemu",
  "physical_hardware_status": "PENDING",
  "identity_policy": {
    "stable_fields": [
      "device_id",
      "bdf",
      "io_base",
      "mmio_base",
      "irq",
      "version"
    ],
    "source": "diagnosticos do guest e parametros do perfil QEMU",
    "unexpected_change": "FAIL"
  },
  "availability_states": [
    "ABSENT",
    "UNSUPPORTED",
    "FAILED",
    "POLICY_DISABLED",
    "INVENTORIED",
    "INITIALIZED",
    "VALIDATED",
    "DEGRADED"
  ],
  "state_semantics": {
    "ABSENT": "hardware nao existe no perfil",
    "UNSUPPORTED": "hardware detectado sem driver compativel",
    "FAILED": "driver detectado mas inicializacao falhou",
    "POLICY_DISABLED": "hardware desativado intencionalmente pelo perfil",
    "INVENTORIED": "hardware identificado sem validacao funcional",
    "INITIALIZED": "driver inicializado sem validacao funcional",
    "VALIDATED": "capacidade exercitada e confirmada",
    "DEGRADED": "capacidade parcial com fallback publicado"
  },
  "driver_states": [
    "INVENTORIED",
    "INITIALIZED",
    "VALIDATED",
    "FAILED",
    "NOT_APPLICABLE"
  ],
  "diagnostics": [
    "health",
    "regcheck full",
    "devices",
    "device-scan"
  ],
  "profiles": [
    {
      "id": "baseline",
      "runner_profile": "baseline",
      "required": true,
      "hardware": [
        {"id": "acpi", "availability_state": "VALIDATED", "driver_state": "VALIDATED", "capability": "acpi"},
        {"id": "pci", "availability_state": "VALIDATED", "driver_state": "VALIDATED", "capability": "pci"},
        {"id": "vga", "availability_state": "VALIDATED", "driver_state": "VALIDATED", "capability": "vga"},
        {"id": "network-e1000", "availability_state": "VALIDATED", "driver_state": "VALIDATED", "capability": "network-e1000"}
      ],
      "fallback": "none",
      "expected_error": "none",
      "diagnostics": ["health", "regcheck full", "devices", "device-scan"],
      "case_ids": ["qemu:tst6:matrix:baseline"]
    },
    {
